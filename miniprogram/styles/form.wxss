/** 共享表单样式 */

.form-item {
  margin-bottom: 20rpx;
}
.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}
.form-input {
  height: 80rpx;
  padding: 0 20rpx;
  background: #f9f9f9;
  border-radius: var(--radius);
  font-size: 28rpx;
}

.upload-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.upload-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius);
  overflow: visible;
  position: relative;
}
.upload-img { width: 100%; height: 100%; }
.upload-add {
  border: 2rpx dashed var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9f9f9;
}
.upload-icon { font-size: 60rpx; color: var(--text-hint); }

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  z-index: 100;
}
