/** 声明与免责说明确认页 */
.disclaimer {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg-card);
  box-sizing: border-box;
}

.brand {
  padding: 64rpx 40rpx 28rpx;
  text-align: center;
  flex-shrink: 0;
}
.brand-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: var(--text-primary);
}
.brand-sub {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--text-hint);
}

.doc {
  flex: 1;
  box-sizing: border-box;
}
.doc-inner {
  padding: 20rpx 40rpx 40rpx;
}
.lead {
  font-size: 26rpx;
  color: var(--text-secondary);
  background: #F7FBF8;
  border: 1rpx solid #D8F0E4;
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 36rpx;
  line-height: 1.7;
}
.section {
  margin-bottom: 38rpx;
}
.sec-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--primary);
  margin-bottom: 14rpx;
}
.sec-body {
  display: block;
  font-size: 27rpx;
  color: var(--text-secondary);
  line-height: 1.85;
}
.sec-foot {
  font-size: 24rpx;
  color: var(--text-hint);
  line-height: 1.7;
  margin-top: 10rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border);
}

.footer {
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
  background: #fff;
  flex-shrink: 0;
}
.agree-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}
.checkbox.checked {
  background: var(--primary);
  border-color: var(--primary);
}
.check-mark {
  color: #fff;
  font-size: 26rpx;
  line-height: 1;
}
.agree-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}
.decline {
  text-align: center;
  margin-top: 22rpx;
  font-size: 26rpx;
  color: var(--text-hint);
}
