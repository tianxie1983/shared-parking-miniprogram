<!-- 声明与免责说明确认页（启动页，仅首次显示） -->
<view class="disclaimer">
  <view class="brand">
    <text class="brand-title">邻里共享停车</text>
    <text class="brand-sub">平台声明与免责条款</text>
  </view>

  <scroll-view scroll-y class="doc">
    <view class="doc-inner">
      <view class="lead">欢迎使用邻里共享停车。在使用本服务前，请仔细阅读以下声明与免责条款。点击"同意并进入"即表示您已充分理解并接受全部内容。</view>

      <view class="section" wx:for="{{sections}}" wx:key="title">
        <text class="sec-title">{{item.title}}</text>
        <text class="sec-body">{{item.body}}</text>
      </view>

      <view class="sec-foot">本声明自您同意之日起生效。我们保留在法律规定范围内修订本声明的权利，修订后将通过适当方式公示。</view>
    </view>
  </scroll-view>

  <view class="footer">
    <view class="agree-row" bindtap="onToggleAgree">
      <view class="checkbox {{agreed ? 'checked' : ''}}">
        <text wx:if="{{agreed}}" class="check-mark">✓</text>
      </view>
      <text class="agree-text">我已阅读并理解以上声明与免责条款</text>
    </view>
    <button class="btn btn-primary btn-block {{agreed ? '' : 'btn-disabled'}}" bindtap="onAgree" disabled="{{!agreed}}">同意并进入</button>
    <view class="decline" bindtap="onDecline">暂不同意，退出</view>
  </view>
</view>
