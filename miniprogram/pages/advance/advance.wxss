/* 进阶页样式（自包含，便于复制到任意页面） */
.banner {
  background: linear-gradient(90deg, #07C160, #09BB07);
  color: #fff;
  padding: 28rpx 30rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.login-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.login-row:last-child { border-bottom: none; }

.mono {
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  color: #333;
  word-break: break-all;
  max-width: 60%;
  text-align: right;
}
.mono.addr { max-width: 70%; }

.map {
  width: 100%;
  height: 440rpx;
  border-radius: 16rpx;
  margin-top: 16rpx;
}

.avatar-line { align-items: center; }
.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #E8F8EF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #07C160;
  line-height: 1.2;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 120rpx; height: 120rpx; border-radius: 50%; }
.nick-input {
  flex: 1;
  margin-left: 24rpx;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.tip { background: #fafafa; }
.tip-item { padding: 6rpx 0; line-height: 1.5; }

.tag-yellow { background: #FFF7E6; color: #FA8C16; }
.tag-green { background: #E8F8EF; color: #07C160; }
