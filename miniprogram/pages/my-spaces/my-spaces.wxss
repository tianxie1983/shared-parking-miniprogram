.container { padding: 24rpx; }

.stats-bar {
  display: flex;
  background: #fff;
  border-radius: var(--radius);
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
}
.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.space-card { margin-bottom: 24rpx; }
.space-info { padding: 12rpx 0; }
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.empty-wrapper {
  text-align: center;
  padding: 120rpx 0;
}
.empty-icon { font-size: 80rpx; display: block; }
.empty-text { color: #999; font-size: 28rpx; margin-top: 16rpx; display: block; }

.flex-1 { flex: 1; }
