/** 信用分样式 */
.score-card {
  padding: 60rpx 0;
  text-align: center;
  background: white;
  margin-bottom: 20rpx;
}
.score-circle {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 6rpx solid var(--primary);
}
.score-circle.good { border-color: #07C160; }
.score-circle.warn { border-color: #FFC300; }
.score-circle.bad { border-color: #FA5151; }
.score-num { font-size: 72rpx; font-weight: bold; color: var(--text-primary); }
.score-label { font-size: 24rpx; color: var(--text-hint); }
.score-tip { display: block; margin-top: 20rpx; font-size: 28rpx; color: var(--primary); }

.rule-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.record-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.record-item:last-child { border-bottom: none; }
