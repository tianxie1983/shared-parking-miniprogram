/** 发布车位样式（用户版） */
page { padding-bottom: 140rpx; background: var(--bg-page); }

.form-item {
  margin-bottom: 20rpx;
}
.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 10rpx;
}
.form-input {
  height: 80rpx;
  padding: 0 20rpx;
  background: #f9f9f9;
  border-radius: var(--radius);
  font-size: 28rpx;
}

/* 批量设置 */
.batch-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  flex-wrap: wrap;
}
.batch-btn {
  padding: 8rpx 20rpx;
  background: #E8F8EF;
  color: var(--primary);
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 时段行 */
.schedule-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 8rpx;
}

/* 日期启用/禁用切换 */
.day-toggle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.day-toggle.enabled {
  background: var(--primary);
  border-color: var(--primary);
}
.day-check {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

/* 时间选择器 */
.time-picker {
  min-width: 120rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9f9f9;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
}
.time-picker.disabled {
  opacity: 0.4;
}

.upload-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.upload-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius);
  overflow: visible;
  position: relative;
}
.upload-img { width: 100%; height: 100%; }
.upload-add {
  border: 2rpx dashed var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9f9f9;
}
.upload-icon { font-size: 60rpx; color: var(--text-hint); }

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  z-index: 100;
}
