/* 投诉记录页样式 */
.complaint-card { margin-bottom: 24rpx; }

.complaint-desc {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 20rpx 0;
}

.photo-row {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}
.complaint-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.result-box {
  background: #f0fff4;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
  border: 1rpx solid #e0f0e0;
}
.result-text {
  margin-top: 12rpx;
  line-height: 1.6;
}

.pending-hint {
  background: #fff8e1;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
  text-align: center;
}

.empty-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { color: #999; font-size: 28rpx; }
