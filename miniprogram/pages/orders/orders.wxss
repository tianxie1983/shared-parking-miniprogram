/** 订单列表样式 */
.tab-bar {
  display: flex;
  background: var(--bg-card);
  padding: 0 20rpx;
  border-bottom: 1rpx solid var(--border);
  white-space: nowrap;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  position: relative;
}
.tab-item.active {
  color: var(--primary);
  font-weight: bold;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}

.active-order-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 30rpx;
  background: #E8F8EF;
  gap: 10rpx;
  font-size: 26rpx;
  color: var(--primary);
}
.pulse-dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--primary);
  border-radius: 50%;
  animation: pulse 1.5s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.order-list {
  height: calc(100vh - 160rpx - env(safe-area-inset-bottom));
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

.order-card {
  background: var(--bg-card);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.order-body { margin-bottom: 16rpx; }
.order-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius);
  background: #f0f0f0;
  flex-shrink: 0;
}
.order-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}
