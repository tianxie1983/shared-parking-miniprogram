<!--
  订单列表页
  对应方案：三.MVP核心功能清单 - 3.1 我的订单
  状态标签：待支付/待入场/停车中/已完成/已取消/争议中
-->
<view class="container">
  <!-- 标签切换栏 -->
  <view class="tab-bar">
    <view class="tab-item {{currentTab === -1 ? 'active' : ''}}" bindtap="onTabChange" data-tab="-1">
      <text>全部</text>
    </view>
    <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="onTabChange" data-tab="0">
      <text>待支付</text>
    </view>
    <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="onTabChange" data-tab="1">
      <text>待入场</text>
    </view>
    <view class="tab-item {{currentTab === 2 ? 'active' : ''}}" bindtap="onTabChange" data-tab="2">
      <text>停车中</text>
    </view>
    <view class="tab-item {{currentTab === 3 ? 'active' : ''}}" bindtap="onTabChange" data-tab="3">
      <text>已完成</text>
    </view>
  </view>

  <!-- 活跃订单提醒 -->
  <view class="active-order-bar" wx:if="{{activeOrder}}" bindtap="onActiveOrderTap">
    <text class="pulse-dot"></text>
    <text>当前有活跃订单</text>
    <text class="text-primary text-sm">查看 ➤</text>
  </view>

  <!-- 订单列表 -->
  <scroll-view class="order-list" scroll-y enhanced show-scrollbar="{{false}}"
    refresher-enabled refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullRefresh" bindscrolltolower="onLoadMore">
    <view wx:if="{{orders.length === 0 && !loading}}">
      <empty-state icon="📋" text="暂无订单" />
    </view>

    <view class="order-card" wx:for="{{orders}}" wx:key="orderId"
      bindtap="onOrderTap" data-order-id="{{item.orderId}}" data-status="{{item.orderStatus}}">
      <!-- 状态标签 -->
      <view class="order-header">
        <text class="tag {{item.orderStatus === 3 ? 'tag-gray' : item.orderStatus === 2 ? 'tag-green' : item.orderStatus === 5 ? 'tag-red' : 'tag-yellow'}}">
          {{statusMap[item.orderStatus]}}
        </text>
        <text class="text-hint text-sm" wx:if="{{item.orderStatus === 3}}">{{item.createdAt}}</text>
        <text class="text-danger text-sm" wx:if="{{item.isOvertime === 1}}">超时</text>
      </view>

      <!-- 车位信息 -->
      <view class="order-body flex">
        <image src="{{item.image}}" mode="aspectFill" class="order-img" />
        <view class="flex-1" style="margin-left: 16rpx;">
          <text class="text-bold">{{item.communityName}}</text>
          <view class="flex mt-10">
            <text class="text-secondary text-sm">📍 {{item.locationDetail}}</text>
          </view>
          <view class="flex mt-10">
            <text class="text-hint text-sm">{{item.startTime}} ~ {{item.endTime}}</text>
          </view>
        </view>
      </view>

      <!-- 费用 -->
      <view class="order-footer">
        <text class="text-secondary text-sm">合计</text>
        <text class="price">
          <text class="price-symbol">¥</text>
          <text class="price-num">{{item.totalAmount}}</text>
        </text>
      </view>

      <!-- 快捷操作 -->
      <view class="order-actions" wx:if="{{item.orderStatus === 0 || item.orderStatus === 1 || item.orderStatus === 2}}">
        <button class="btn btn-primary btn-sm" wx:if="{{item.orderStatus === 0}}" catchtap="onQuickPay" data-order-id="{{item.orderId}}">
          去支付
        </button>
        <button class="btn btn-outline btn-sm" wx:if="{{item.orderStatus === 1}}" catchtap="onOrderTap" data-order-id="{{item.orderId}}">
          查看详情
        </button>
        <button class="btn btn-primary btn-sm" wx:if="{{item.orderStatus === 2}}" catchtap="onOrderTap" data-order-id="{{item.orderId}}">
          停车中 · 查看详情
        </button>
      </view>
    </view>

    <view wx:if="{{!hasMore && orders.length > 0}}" class="load-more">— 没有更多了 —</view>
    <view style="height: 160rpx;"></view>
  </scroll-view>
</view>
